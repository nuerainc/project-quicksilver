{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "studio": {
      "root": "apps/studio",
      "framework": "sanity"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "sdk-python": {
      "root": "packages/sdk-python",
      "runtime": "python"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
