{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "studio": {
      "root": "apps/studio",
      "framework": "sanity"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    }
  },
  "rewrites": [
    {
      "source": "/studio",
      "destination": {
        "service": "studio"
      }
    },
    {
      "source": "/studio/(.*)",
      "destination": {
        "service": "studio"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
