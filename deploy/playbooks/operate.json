 "stepCapabilities": {
  "observe/work": "capability-read-company-state",
  "review/work": "capability-review-department-autonomy",
  "act/work": "capability-propose-department-actions",
  "measure/work": "capability-measure-outcomes",
  "reinvest/work": "capability-propose-reinvestment",
  "experiment/work": "capability-propose-experiments"
 },
 "budget": {
  "amountUsd": 250,
  "includesCompute": true
 },
 "metrics": [
  {
   "id": "return-on-capital",
   "label": "Revenue per dollar of capital used in the period (compute included)",
   "unit": "ratio",
   "direction": "higher-is-better",
   "kill": 0.5,
   "hold": 1.0,
   "scale": 1.5
  }
 ],
 "outputs": [
  "department autonomy review",
  "period money totals",
  "founder-approved reinvestment plans",
  "bounded experiment records",
  "hash-chained money ledger"
 ],
 "owner": "entity-founder"
}
