     "id": "start",
     "kind": "trigger",
     "label": "Start"
    },
    {
     "id": "work",
     "kind": "agent",
     "label": "Propose department actions; each goes through the kernel, runs only within the department's effective autonomy, and otherwise stays a recommendation",
     "config": {
