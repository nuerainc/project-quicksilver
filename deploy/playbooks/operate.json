    }
   ]
  },
  "measure": {
   "schemaVersion": 1,
   "id": "operate-measure",
   "version": 1,
   "entryNodeId": "start",
   "nodes": [
    {
     "id": "start",
     "kind": "trigger",
     "label": "Start"
    },
    {
     "id": "work",
     "kind": "agent",
     "label": "Measure outcomes of the period's actions against their expected results (read only)",
     "config": {
      "agentId": "query",
      "evaluationRequired": true,
      "impact": "low"
     }
    },
    {
     "id": "done",
     "kind": "output",
     "label": "Done"
    }
   ],
   "edges": [
