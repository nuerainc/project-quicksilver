# Nuera Quicksilver host: worker pool, schedules, signed webhooks, management API.
# Build from the repository root:
#   docker build -f deploy/Dockerfile.host -t quicksilver-host .
FROM node:22-slim
WORKDIR /app
# Secrets never enter the image: .dockerignore excludes .env files and local data.
COPY . .
RUN npm ci --no-audit --no-fund \
  && npm cache clean --force \
  && mkdir -p /data && chown node:node /data
ENV NODE_ENV=production
# Run as the unprivileged "node" user; the file store and vault live in /data.
USER node
EXPOSE 8787
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s CMD node -e "fetch('http://127.0.0.1:8787/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENV QUICKSILVER_HOST_CONFIG=/config/quicksilver.host.json
CMD ["node_modules/.bin/tsx", "packages/host/src/main.ts"]
