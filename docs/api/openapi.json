  "components": {
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "retryAfterSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "code": {
            "type": "string"
          },
          "needs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "description": "Common fields where emitted; not guaranteed across all routes.",
        "additionalProperties": true
      },
      "JsonObject": {
        "type": "object",
        "description": "Route-specific shape not exhaustively captured yet.",
        "additionalProperties": true
      },
      "Whoami": {
        "type": "object",
        "properties": {
          "credential": {
            "type": "string",
            "enum": [
              "principal",
              "shared-supervisor"
            ]
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "displayName": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "tenantId": {
            "type": "string"
          },
          "principalId": {
            "type": "string"
          }
        },
        "additionalProperties": false,
        "required": [
          "principalId",
          "kind",
          "tenantId",
          "permissions",
          "credential"
        ]
      }
    },
    "requestBodies": {
      "JsonObject": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/JsonObject"
            }
          }
        },
        "required": true
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "bearerFormat": "opaque principal or configured supervisor token",
        "type": "http",
        "scheme": "bearer"
      }
    },
    "responses": {
      "RateLimitResponse": {
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
