# Nuera Quicksilver — environment template

# Historical Quicksilver Sanity Challenge project. Keep as a reference only;
# new schemas, decisions, and platform data belong in the dedicated project.
LEGACY_SANITY_PROJECT_ID=d280bqjc
LEGACY_SANITY_DATASET=production

# Dedicated Nuera Quicksilver Sanity project (ID pending).
# Set these after creating/selecting the new Sanity project and configuring
# its Context MCP endpoints. The app must never fall back to the legacy project.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-10-01
SANITY_AUTH_TOKEN=
SANITY_ORG_ID=
SANITY_CONTEXT_MCP_URL=
SANITY_CONTEXT_TOKEN=
SANITY_CONTEXT_KB_MCP_URL=
SANITY_CONTEXT_KB_TOKEN=
SANITY_KNOWLEDGE_BASE_ID=

# LLM providers
# Models are role-based in packages/agent/src/models.ts
# You only need to set the provider you intend to use. Mode is auto-detected:
# azure (if AZURE_API_KEY + AZURE_RESOURCE_NAME are set) > cloud (any other
# key) > local. Force one with QUICKSILVER_MODEL_MODE=azure|cloud|local.
# Check your setup with:  npm run verify:llm
# ─────────────────────────────────────────────────────────────────

# Azure OpenAI / Foundry — the "model" is your DEPLOYMENT NAME.
# Defaults: qs-planner, qs-reviewer, qs-router, qs-executor.
# (Keep comments on their own lines: the repo's .env loaders read everything
# after "=" as the value.)
#
# Resource name = the part before .openai.azure.com
AZURE_RESOURCE_NAME=
# Key 1 from "Keys and Endpoint" in the Azure portal
AZURE_API_KEY=
#
# Optional: route every role to one deployment
# AZURE_DEPLOYMENT=
# Optional: per-role deployment override (PLANNER | REVIEWER | ROUTER | EXECUTOR)
# QUICKSILVER_PLANNER_MODEL=
# Optional: "responses" (default) or "chat"
# AZURE_API_MODE=chat
# Optional: API version (default v1)
# AZURE_API_VERSION=v1

# Direct provider keys (cloud mode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Force inference mode: azure | cloud | local (auto-detected if unset)
# QUICKSILVER_MODEL_MODE=azure
# Local mode: Ollama OpenAI-compatible endpoint
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Per-role model overrides — useful when you only have one provider,
# e.g. Claude-only setup with paid Claude Code plan:
#   QUICKSILVER_PLANNER_MODEL=claude-sonnet-5
#   QUICKSILVER_REVIEWER_MODEL=claude-sonnet-5
#   QUICKSILVER_ROUTER_MODEL=claude-haiku-4-5
#   QUICKSILVER_EXECUTOR_MODEL=claude-sonnet-5
#
# Local-mode model tags (Ollama):
#   QUICKSILVER_LOCAL_PLANNER=qwen2.5:7b
#   QUICKSILVER_LOCAL_REVIEWER=qwen2.5:7b
#   QUICKSILVER_LOCAL_ROUTER=qwen2.5:7b
#   QUICKSILVER_LOCAL_EXECUTOR=qwen2.5:7b

# ─────────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────────
# Informational only (the UI doesn't read it).
NEXT_PUBLIC_APP_NAME=Quicksilver
QUICKSILVER_RISK_AUTO_MAX=2
QUICKSILVER_RISK_REVIEW_THRESHOLD=3

# Live workflow runs are disabled unless explicitly enabled. When enabled,
# only read-only query-agent steps run; tools always remain blocked. Keep this
# off on public deployments until authentication and rate limits are installed.
# QUICKSILVER_WORKFLOW_LIVE_RUNS=on

# NOTE: there is deliberately no third "prohibited" threshold here. The kernel
# (packages/kernel/src/approval.ts) only reads QUICKSILVER_RISK_AUTO_MAX and
# QUICKSILVER_RISK_REVIEW_THRESHOLD; a hard-reject-above-risk-N tier was never
# implemented, so a QUICKSILVER_RISK_PROHIBITED var here would silently do
# nothing. Removed rather than left as a documented no-op.

# Process engine (feature flag). When "on", decision status changes are
# authorized by the kernel against the "Decision Lifecycle" process
# definition stored in Sanity (workflow-decision-lifecycle), instead of the
# routes' built-in checks. Push the definitions first: npm run seed:processes
# If the definition isn't in the dataset, the app falls back to the built-in
# lifecycle; if it's there but invalid, the kernel moves nothing.
QUICKSILVER_PROCESS_ENGINE=off

# Fault injection for the simulated executor (testing only). When "on",
# POST /api/decisions/[id]/execute accepts { "inject": "success" | "failure" |
# "deviation" } so `npm run e2e:live` can force a failed rollback or a metric
# moving the wrong way. Forced runs are stamped `faultInjection` on the
# decision and its metric. Leave off unless you are running the e2e test.
QUICKSILVER_ALLOW_FAULT_INJECTION=off

# Interim server-to-server supervisor gate for decision lifecycle mutations.
# Configure a dedicated human entity id in Nuera Quicksilver Sanity and a
# random token of at least 32 characters. Never expose this token to browser code.
# Approval requests must send: Authorization: Bearer <NQC_SUPERVISOR_TOKEN>
# NQC_SUPERVISOR_ID=entity-your-supervisor
# NQC_SUPERVISOR_TOKEN=replace-with-a-random-secret-of-at-least-32-characters

# Base URL for `npm run e2e:live` (default: the production deployment).
# QUICKSILVER_E2E_BASE_URL=https://quicksilver-seven.vercel.app
