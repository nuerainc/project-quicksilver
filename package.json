{
  "name": "quicksilver",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Autonomous Company Operating System \u2014 Sanity Challenge 2026",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace=@quicksilver/web",
    "dev:studio": "npm run dev --workspace=@quicksilver/studio",
    "build": "npm run build --workspaces --if-present",
    "schema:deploy": "npm run schema:deploy --workspace=@quicksilver/studio",
    "smoke": "npm run smoke --workspace=@quicksilver/studio",
    "seed": "npm run seed --workspace=@quicksilver/studio",
    "verify:mcp": "npm run verify:mcp --workspace=@quicksilver/agent",
    "verify:llm": "npm run verify:llm --workspace=@quicksilver/agent",
    "setup:azure": "node scripts/setup-azure.mjs",
    "kernel:test": "node --experimental-strip-types --no-warnings --test packages/kernel/src/kernel.test.ts",
    "agent:test": "node --experimental-strip-types --no-warnings --test packages/agent/src/models.test.ts",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
