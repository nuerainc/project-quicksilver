{
  "name": "quicksilver",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Nuera Quicksilver: cognitive and automation platform (inspired by the Quicksilver Sanity Challenge submission)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace=@quicksilver/web",
    "dev:studio": "npm run dev --workspace=@quicksilver/studio",
    "build": "npm run build --workspaces --if-present",
    "schema:deploy": "npm run schema:deploy --workspace=@quicksilver/studio",
    "smoke": "npm run smoke --workspace=@quicksilver/studio",
    "seed": "npm run seed --workspace=@quicksilver/studio",
    "seed:processes": "npm run seed:processes --workspace=@quicksilver/studio",
    "reset:history": "npm run reset:history --workspace=@quicksilver/studio --",
    "e2e:live": "npm run e2e:live --workspace=@quicksilver/studio --",
    "verify:mcp": "npm run verify:mcp --workspace=@quicksilver/agent",
    "verify:llm": "npm run verify:llm --workspace=@quicksilver/agent",
    "setup:azure": "node scripts/setup-azure.mjs",
    "principal:token": "node --experimental-strip-types --no-warnings scripts/principal-token.ts",
    "kernel:test": "node --experimental-strip-types --no-warnings --test packages/kernel/src/kernel.test.ts packages/kernel/src/process.test.ts packages/kernel/src/workflows/workflows.test.ts packages/kernel/src/nqc/nqc.test.ts packages/kernel/src/runtime/runtime.test.ts packages/kernel/src/identity/identity.test.ts",
    "agent:test": "node --experimental-strip-types --no-warnings --test packages/agent/src/models.test.ts packages/agent/src/schemas.test.ts",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20"
  }
}
