{
  "name": "quicksilver",
  "version": "0.3.0",
  "private": true,
  "license": "MIT",
  "description": "Nuera Quicksilver: intent-driven company operating system governed by the deterministic NQC Kernel (inspired by the Quicksilver Sanity Challenge submission)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev --workspace=@quicksilver/web",
    "dev:studio": "npm run dev --workspace=@quicksilver/studio",
    "host": "npm run start --workspace=@quicksilver/host --",
    "build": "npm run build --workspaces --if-present",
    "schema:deploy": "npm run schema:deploy --workspace=@quicksilver/studio --",
    "smoke": "npm run smoke --workspace=@quicksilver/studio",
    "seed": "npm run seed --workspace=@quicksilver/studio",
    "seed:processes": "npm run seed:processes --workspace=@quicksilver/studio",
    "reset:history": "npm run reset:history --workspace=@quicksilver/studio --",
    "e2e:live": "npm run e2e:live --workspace=@quicksilver/studio --",
    "verify:mcp": "npm run verify:mcp --workspace=@quicksilver/agent",
    "verify:llm": "npm run verify:llm --workspace=@quicksilver/agent",
    "setup:azure": "node scripts/setup-azure.mjs",
    "principal:token": "node --experimental-strip-types --no-warnings scripts/principal-token.ts",
    "kernel:test": "node --experimental-strip-types --no-warnings --test packages/kernel/src/kernel.test.ts packages/kernel/src/authority.test.ts packages/kernel/src/process.test.ts packages/kernel/src/workflows/workflows.test.ts packages/kernel/src/nqc/nqc.test.ts packages/kernel/src/runtime/runtime.test.ts packages/kernel/src/identity/identity.test.ts packages/kernel/src/identity/separation.test.ts packages/kernel/src/triggers/triggers.test.ts packages/kernel/src/runtime/store-contract.test.ts packages/kernel/src/playbooks/playbook.test.ts packages/kernel/src/playbooks/shadow.test.ts",
    "agent:test": "node --experimental-strip-types --no-warnings --test packages/agent/src/models.test.ts packages/agent/src/schemas.test.ts packages/agent/src/contracts.test.ts",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed:test": "node --experimental-strip-types --no-warnings --test apps/studio/seed/policies.test.ts",
    "host:test": "node --experimental-strip-types --no-warnings --test packages/host/src/host.test.ts packages/host/src/vault.test.ts packages/host/src/observability.test.ts packages/host/src/config.test.ts packages/host/src/intent-api.test.ts",
    "aura:test": "node --experimental-strip-types --no-warnings --test packages/aura/src/aura.test.ts packages/aura/src/ledger.test.ts packages/aura/src/profile.test.ts packages/aura/src/store.test.ts packages/aura/src/predict.test.ts packages/aura/src/onboard.test.ts",
    "aura:eval": "node --experimental-strip-types --no-warnings packages/aura/src/eval-cli.ts",
    "aura:choices": "node --experimental-strip-types --no-warnings packages/aura/src/choice-cli.ts",
    "aura:agreement": "node --experimental-strip-types --no-warnings packages/aura/src/agreement-cli.ts",
    "aura:eval:model": "npm run intent:eval --workspace=@quicksilver/agent --"
  },
  "engines": {
    "node": ">=20"
  }
}
