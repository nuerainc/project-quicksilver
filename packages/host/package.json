{
  "name": "@quicksilver/host",
  "version": "0.4.0",
  "private": true,
  "license": "MIT",
  "description": "Single-tenant hosted runtime: worker, schedules, signed webhooks, management API, secrets vault, logs and metrics",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./vault": "./src/vault.ts",
    "./log": "./src/log.ts",
    "./metrics": "./src/metrics.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start": "tsx src/main.ts",
    "onboard": "tsx src/onboard-cli.ts",
    "genesis": "tsx src/genesis-cli.ts",
    "operate": "tsx src/operate-cli.ts",
    "whatif": "tsx src/whatif-cli.ts",
    "tasks": "tsx src/tasks-cli.ts",
    "mcp:tasks": "node --experimental-strip-types --no-warnings src/mcp-tasks.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@quicksilver/agent": "*",
    "@quicksilver/aura": "*",
    "@quicksilver/kernel": "*",
    "@sanity/client": "^6.22.5",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
