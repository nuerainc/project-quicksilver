    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "@quicksilver/agent": "*",
    "@quicksilver/kernel": "*",
    "@sanity/client": "^6.22.5",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
